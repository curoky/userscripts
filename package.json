{
  "name": "userscripts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.14.0 <13"
  },
  "scripts": {
    "audit": "pnpm audit --audit-level high",
    "build": "tsdown",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "biome check --write .",
    "lint": "biome ci .",
    "prepare": "lefthook install",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/firefox-webext-browser": "143.0.1",
    "@violentmonkey/types": "0.3.4",
    "chrome-types": "0.1.457",
    "happy-dom": "21.0.4",
    "lefthook": "2.2.2",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "user-agent-data-types": "0.4.3",
    "vitest": "5.0.5"
  }
}
